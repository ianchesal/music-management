#!/usr/bin/env python3
"""
phish-rename — Rename new Phish live show downloads to canonical LivePhish format.

Scans PATH for directories that aren't already in canonical form and contain a
YYYY-MM-DD, YYYY_MM_DD, or YYYY.MM.DD date anywhere in their name (e.g. a raw
date dir, or a hand-named "Phish-YYYY-MM-DD.Some.Location" dir with no ID
suffix), looks up each show on livephish.com, discards any search results
whose actual date doesn't match (livephish.com's search is fuzzy text
matching, not a strict date filter) and any whose location doesn't match
location text already in the directory name, and renames to:
  Phish-YYYY-MM-DD.Dot.Separated.Location.[LivePhishID]

Shows livephish.com has no release for (never toured commercially, or not
yet released) are reported as "not found" rather than renamed — since there
is no LivePhish ID to build a canonical name from. In that case phish.net is
queried as a courtesy to confirm the show and report its venue, purely for
your manual research; it never drives a rename.

Repeat runs skip directories that were already checked and haven't changed
since (same name, same mtime) — a directory that previously came back "not
found" or "location mismatch" is remembered and not re-queried against
livephish.com. Since that skip never expires on its own (checking is bursty
around tour season, not evenly spread over time, so a calendar-based
expiry would just retrigger a network round trip for no reason tied to
anything actually changing), pass --rescan when you specifically want a
fresh check of everything — e.g. you know livephish.com has just added a
release. State is cached in a small JSON file, separate from the directory
contents, so this is safe to interrupt or run alongside other tools.

Usage:
  phish-rename PATH
  phish-rename PATH --dry-run
  phish-rename PATH --execute

If PATH is omitted, it defaults to $PHISH_COLLECTION_DIR (or the value of
PHISH_COLLECTION_DIR in a .env file at the repo root, if the real
environment variable isn't set).

Options:
  PATH          Directory containing show subdirectories
                [default: $PHISH_COLLECTION_DIR]
  --dry-run     Print planned renames, touch nothing [default]
  --execute     Perform the actual renames
  --rescan      Ignore cached skip results; re-check every directory
  --state FILE  Skip-cache location [default: $XDG_CACHE_HOME/phish-rename-state.json]
  -h, --help    Show this message
"""

import json
import os
import re
import sys
import time
from pathlib import Path

import requests
from bs4 import BeautifulSoup

# ── Config ─────────────────────────────────────────────────────────────────────

COLLECTION_ENV_VAR = "PHISH_COLLECTION_DIR"


def _dotenv_path():
    return Path(__file__).resolve().parent.parent / ".env"


def _load_dotenv():
    path = _dotenv_path()
    if not path.exists():
        return
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        os.environ.setdefault(key, value)


def default_collection_path():
    _load_dotenv()
    value = os.environ.get(COLLECTION_ENV_VAR)
    return Path(value) if value else None

# ── Terminal ───────────────────────────────────────────────────────────────────

try:
    COLS = min(os.get_terminal_size().columns, 160)
except OSError:
    COLS = 120

USE_COLOR = sys.stdout.isatty()


def _ansi(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else s


def bold(s):   return _ansi("1",  s)
def dim(s):    return _ansi("2",  s)
def yellow(s): return _ansi("93", s)
def green(s):  return _ansi("92", s)


def warn(dirname: str, *details: str):
    print(f"  {yellow('WARN')} {dirname}:", file=sys.stderr)
    for detail in details:
        print(f"        {detail}", file=sys.stderr)


# ── Constants ──────────────────────────────────────────────────────────────────

SEARCH_URL = (
    "https://www.livephish.com/on/demandware.store/"
    "Sites-LivePhish-Site/default/Search-Show"
    "?search-button=&q={date}&lang=default"
)

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    )
}

PHISHNET_URL = "https://phish.net/setlists/?d={date}"

# ── Skip-state cache ───────────────────────────────────────────────────────────

def default_state_path() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    return Path(base) / "phish-rename-state.json"


def load_state(path: Path) -> dict:
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2, sort_keys=True)
    tmp.replace(path)


# ── Core functions ─────────────────────────────────────────────────────────────

def date_from_dirname(dirname: str):
    m = re.search(r'(?<!\d)(\d{4})[-_.](\d{1,2})[-_.](\d{1,2})\b', dirname)
    if m:
        y, mo, d = m.group(1), int(m.group(2)), int(m.group(3))
        return f"{y}-{mo:02d}-{d:02d}"
    return None


def is_conforming(dirname: str) -> bool:
    return bool(re.match(r'^Phish-\d{4}-\d{2}-\d{2}\..+\.\[\d+\]$', dirname))


# Words too generic to prove a location match on their own (e.g. "Center"
# alone shouldn't confirm two different arenas are the same place).
GENERIC_LOCATION_WORDS = {
    "the", "center", "centre", "arena", "theatre", "theater", "amphitheater",
    "amphitheatre", "auditorium", "pavilion", "civic", "memorial", "hall",
    "coliseum", "field", "stadium", "ballroom", "park", "complex", "grounds",
    "fairgrounds", "university", "college", "club", "casino", "resort",
    "hotel", "concert", "music", "festival", "campus",
}


def location_tokens(text: str) -> set:
    text = text.lower().replace("’", "'")
    words = re.findall(r"[a-z0-9']+", text)
    return {w.strip("'") for w in words} - GENERIC_LOCATION_WORDS


def extract_location_hint(dirname: str) -> str:
    remainder = re.sub(r'^Phish-', '', dirname)
    remainder = re.sub(r'(?<!\d)\d{4}[-_.]\d{1,2}[-_.]\d{1,2}\b', '', remainder, count=1)
    remainder = re.sub(r'\.?\[\d+\]$', '', remainder)
    return remainder


def location_matches(dirname: str, candidate_location: str) -> bool:
    hint_tokens = location_tokens(extract_location_hint(dirname))
    if not hint_tokens:
        return True
    overlap = hint_tokens & location_tokens(candidate_location)
    # A shared 2-letter token (almost always a US state code) isn't enough
    # on its own — Syracuse, NY and New York, NY would "match" on "ny".
    return any(len(token) > 2 for token in overlap)


def location_to_dots(location_str: str) -> str:
    name = location_str.strip()
    name = name.replace(",", "")
    name = re.sub(r"\s+", ".", name.strip())
    return name.strip(".")


def to_canonical_name(date: str, location: str, release_id: str) -> str:
    return f"Phish-{date}.{location}.[{release_id}]"


def alt_text_date(alt: str):
    m = re.match(r'^(\d{1,2})/(\d{1,2})/(\d{2,4})\s*', alt)
    if not m:
        return None
    mo, d, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
    if y < 100:
        y += 2000 if y <= 50 else 1900
    return f"{y:04d}-{mo:02d}-{d:02d}"


def parse_search_results(html: str, expected_date: str = None) -> list:
    soup = BeautifulSoup(html, "html.parser")
    candidates = []
    seen_ids = set()

    for a in soup.find_all("a", href=re.compile(r"^/LP-(\d+)\.html$")):
        img = a.find("img")
        if img is None:
            continue
        alt = img.get("alt", "").strip()
        if "4k" in alt.lower():
            continue
        if expected_date is not None and alt_text_date(alt) != expected_date:
            continue
        release_id = re.search(r"/LP-(\d+)\.html", a["href"]).group(1)
        if release_id in seen_ids:
            continue
        seen_ids.add(release_id)
        location_raw = re.sub(r"^\d{1,2}/\d{1,2}/\d{2,4}\s*", "", alt).strip()
        candidates.append((release_id, location_raw))

    return candidates


def search_livephish(date: str) -> str:
    url = SEARCH_URL.format(date=date)
    resp = requests.get(url, headers=HEADERS, timeout=10)
    resp.raise_for_status()
    return resp.text


def fetch_phishnet_show(date: str):
    """Fetch the phish.net setlist page for date, or None if phish.net has no show that day."""
    url = PHISHNET_URL.format(date=date)
    resp = requests.get(url, headers=HEADERS, timeout=10)
    if resp.status_code == 404:
        return None
    resp.raise_for_status()
    return resp.text


def parse_phishnet_location(html: str):
    """Pull the venue/city/state out of a phish.net setlist page's Event JSON-LD block."""
    m = re.search(r'<script type="application/ld\+json">(.*?)</script>', html, re.DOTALL)
    if not m:
        return None
    try:
        data = json.loads(m.group(1))
    except ValueError:
        return None
    location = data.get("location") or {}
    name = location.get("name", "").strip()
    address = location.get("address", "").strip()
    if not name and not address:
        return None
    if name and address:
        return f"{name}, {address}"
    return name or address


def pick_best_match(candidates: list, dirname: str = None):
    if not candidates:
        return None
    if dirname is not None:
        for candidate in candidates:
            if location_matches(dirname, candidate[1]):
                return candidate
    return candidates[0]


# ── Main logic ─────────────────────────────────────────────────────────────────

def main_logic(path: Path, dry_run: bool, state_path: Path = None, rescan: bool = False):
    renamed = 0
    skipped_conforming = 0
    skipped_not_found = 0
    skipped_collision = 0
    skipped_unrecognized = 0
    skipped_location_mismatch = 0
    skipped_cached = 0

    state = load_state(state_path) if state_path is not None else {}
    now = time.time()

    entries = sorted(path.iterdir(), key=lambda e: e.name.lower())
    for entry in entries:
        if not entry.is_dir() or entry.name.startswith('.'):
            continue

        if is_conforming(entry.name):
            skipped_conforming += 1
            continue

        date = date_from_dirname(entry.name)
        if date is None:
            skipped_unrecognized += 1
            continue

        mtime = entry.stat().st_mtime
        cached = None if (state_path is None or rescan) else state.get(entry.name)
        if cached and cached.get("mtime") == mtime:
            status = cached.get("status")
            if status in ("not_found", "location_mismatch", "collision"):
                reason = status.replace("_", " ")
                print(f"  {dim('SKIP')}      {entry.name} (cached — {reason})")
                skipped_cached += 1
                if status == "not_found":
                    skipped_not_found += 1
                elif status == "location_mismatch":
                    skipped_location_mismatch += 1
                else:
                    skipped_collision += 1
                continue

        try:
            html = search_livephish(date)
            time.sleep(0.5)
        except Exception as e:
            warn(entry.name, f"HTTP error — {e}")
            skipped_not_found += 1
            continue  # transient — don't cache, worth retrying next run

        candidates = parse_search_results(html, expected_date=date)
        match = pick_best_match(candidates, entry.name)

        if match is None:
            lines = ["not found on livephish.com"]
            try:
                pn_html = fetch_phishnet_show(date)
                time.sleep(0.5)
                if pn_html is not None:
                    location = parse_phishnet_location(pn_html)
                    if location:
                        lines.append(f"phish.net confirms this show: {location}")
                        lines.append("no LivePhish release; needs a manual ID")
            except Exception:
                pass
            warn(entry.name, *lines)
            skipped_not_found += 1
            if state_path is not None:
                state[entry.name] = {"mtime": mtime, "checked_at": now, "status": "not_found"}
            continue

        release_id, location_raw = match

        if not location_matches(entry.name, location_raw):
            warn(
                entry.name,
                f"location mismatch — directory suggests a different venue than the best "
                f"livephish.com match ({location_raw.strip()}, [{release_id}]) — needs manual review",
            )
            skipped_location_mismatch += 1
            if state_path is not None:
                state[entry.name] = {"mtime": mtime, "checked_at": now, "status": "location_mismatch"}
            continue

        location = location_to_dots(location_raw)
        new_name = to_canonical_name(date, location, release_id)

        src = path / entry.name
        dst = path / new_name

        if dst.exists():
            warn(entry.name, f"skipping — destination already exists ({new_name})")
            skipped_collision += 1
            if state_path is not None:
                state[entry.name] = {"mtime": mtime, "checked_at": now, "status": "collision"}
            continue

        if dry_run:
            print(f"  [DRY RUN] mv {entry.name} → {new_name}")
        else:
            print(f"  Renaming  {entry.name} → {new_name}")
            src.rename(dst)
            state.pop(entry.name, None)
        renamed += 1

    if state_path is not None:
        current_names = {e.name for e in entries}
        state = {k: v for k, v in state.items() if k in current_names}
        save_state(state_path, state)

    print()
    print(f"  {bold('SUMMARY')}")
    print(f"  {green(str(renamed))}  renamed")
    print(f"  {dim(str(skipped_conforming))}  skipped (already conforming)")
    print(f"  {yellow(str(skipped_not_found))}  skipped (not found on livephish.com)")
    print(f"  {yellow(str(skipped_collision))}  skipped (destination already exists)")
    print(f"  {yellow(str(skipped_location_mismatch))}  skipped (location mismatch — needs manual review)")
    print(f"  {dim(str(skipped_unrecognized))}  skipped (unrecognized format)")
    if state_path is not None:
        print(f"  {dim(str(skipped_cached))}  of the above skipped without a network request (cached)")
    print()


# ── Argument parsing ───────────────────────────────────────────────────────────

def parse_args(argv):
    path = None
    dry_run = True
    rescan = False
    state_path = None

    args = argv[1:]
    i = 0
    while i < len(args):
        if args[i] in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif args[i] == "--dry-run":
            dry_run = True
            i += 1
        elif args[i] == "--execute":
            dry_run = False
            i += 1
        elif args[i] == "--rescan":
            rescan = True
            i += 1
        elif args[i] == "--state":
            if i + 1 >= len(args):
                print("Error: --state requires a file argument", file=sys.stderr)
                sys.exit(1)
            state_path = Path(args[i + 1])
            i += 2
        elif not args[i].startswith("-"):
            path = Path(args[i])
            i += 1
        else:
            print(f"Unknown argument: {args[i]}", file=sys.stderr)
            sys.exit(1)

    if path is None:
        path = default_collection_path()

    if path is None:
        print("Error: PATH is required", file=sys.stderr)
        sys.exit(1)

    if not path.exists():
        print(f"Error: PATH does not exist: {path}", file=sys.stderr)
        sys.exit(1)

    if state_path is None:
        state_path = default_state_path()

    return path, dry_run, rescan, state_path


def main():
    path, dry_run, rescan, state_path = parse_args(sys.argv)
    mode = "DRY RUN" if dry_run else "EXECUTE"
    print(f"\n  {bold('PHISH RENAME')}  [{mode}]")
    print(f"  {dim('Path:')}   {path}")
    print(f"  {dim('State:')}  {state_path}")
    print()
    main_logic(path, dry_run, state_path=state_path, rescan=rescan)


if __name__ == "__main__":
    main()
