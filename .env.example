# Copy to .env (repo root) and fill in your paths.
# Only used as a fallback when the real environment variable isn't set.

# Existing/sorted Phish collection root.
# Used by: phish-rename, phish-retag, phish-merge, phish-compare, phish-intake
PHISH_COLLECTION_DIR=/data/media/Sorted/Unsorted/Music/Phish

# Incoming-content root: the torrent directory for phish-merge/phish-compare,
# and the default zips directory for phish-intake.
PHISH_INTAKE_DIR=/data/torrents/Phish-Live.Phish.Project-2002-2026
